Program 4: 8 Puzzle Game
from collections import deque

def solve(board):
    start = sum(board, [])
    goal = list(range(9))

    if start == goal:
        print("Final Matrix:")
        for i in range(0, 9, 3):
            print(goal[i:i + 3])
        return 0

    moves = [
        [1, 3],
        [0, 2, 4],
        [1, 5],
        [0, 4, 6],
        [1, 3, 5, 7],
        [2, 4, 8],
        [3, 7],
        [4, 6, 8],
        [5, 7]
    ]

    queue = deque([(start, 0)])
    visited = set()

    while queue:
        state, count = queue.popleft()

        if tuple(state) in visited:
            continue

        visited.add(tuple(state))
        zero = state.index(0)

        for i in moves[zero]:
            new_state = state[:]
            new_state[zero], new_state[i] = new_state[i], new_state[zero]

            if new_state == goal:
                print("Final Matrix:")
                for j in range(0, 9, 3):
                    print(new_state[j:j + 3])
                return count + 1

            queue.append((new_state, count + 1))

    return -1


moves = solve([[3, 1, 2], [4, 7, 5], [6, 8, 0]])

print("Minimum moves:", moves)
